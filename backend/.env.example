# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application environment ('development' or 'production')
ENVIRONMENT=production

# Base API Gateway prefix
API_PREFIX=/api/v1

# Client handshake access key required for all incoming API calls
CLIENT_ACCESS_KEY=replace_with_client_key

# Global IP rate limit per minute
RATE_LIMIT_PER_MINUTE=100

# Strict IP rate limit per minute for auth/OTP/login endpoints
AUTH_RATE_LIMIT_PER_MINUTE=5

# Maximum allowed request body size in bytes
MAX_REQUEST_SIZE_BYTES=1048576

# Set false in production to hide Swagger API endpoints from public discovery
DOCS_ENABLED=false

# Secret key used for signing JWT access tokens
JWT_SECRET=replace_with_strong_random_secret_in_production

# JWT token algorithm
JWT_ALGORITHM=HS256

# JWT token expiration in days
JWT_EXPIRE_DAYS=30

# Database connection string
DATABASE_URL=sqlite:///./tour_data.db

# Master Admin 10-digit Indian mobile number
ADMIN_PHONE=9999999999

# Master Admin full name
ADMIN_NAME=Suresh Bhai (Tour Organizer)

# Master Admin secret passphrase
ADMIN_SECRET_KEY=replace_with_admin_secret_key

# Set to false in production to strictly conceal OTP from API responses
EXPOSE_DEMO_OTP=false

# Fixed test OTP for local dev (leave empty in production)
DEMO_OTP_CODE=

# SMS Gateway provider API key
SMS_GATEWAY_API_KEY=

# SMS Gateway sender ID
SMS_SENDER_ID=

# UPI Virtual Payment Address (VPA)
UPI_VPA=sakinakadiwali@upi

# UPI Merchant Name
UPI_NAME=Sakinaka Diwali Yatra Sangh

# Primary Organizer Phone
ORGANIZER_PHONE=+91 98200 45678

# Alternate Phone
ORGANIZER_ALT_PHONE=+91 98200 12345

# Official Email
ORGANIZER_EMAIL=sakinakadiwalitour@gmail.com

# 24x7 Emergency helpline
EMERGENCY_HELPLINE=+91 98200 99999

# WhatsApp Group Link
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/G51k2L4x9diwaliYatraGroup

# Instagram URL
INSTAGRAM_PROFILE_URL=https://instagram.com/sakinakadiwalitour

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server host & port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
